{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build course_manager_web_learning",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "run course_manager_web_learning",
      "type": "shell",
      "command": "${workspaceFolder}\\run.bat",
      "dependsOn": "build course_manager_web_learning",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
