{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build mysql app",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run mysql app",
      "type": "shell",
      "command": "${workspaceFolder}\\run.bat",
      "dependsOn": "build mysql app",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
