.PHONY : xor_cipher.cpp.obj

xor_cipher.i: xor_cipher.cpp.i
.PHONY : xor_cipher.i

# target to preprocess a source file
xor_cipher.cpp.i:
	cd /d D:\7-Zip\code\build && $(MAKE) $(MAKESILENT) -f ciphers\CMakeFiles\xor_cipher.dir\build.make ciphers/CMakeFiles/xor_cipher.dir/xor_cipher.cpp.i
.PHONY : xor_cipher.cpp.i

xor_cipher.s: xor_cipher.cpp.s
.PHONY : xor_cipher.s

# target to generate assembly for a file
xor_cipher.cpp.s:
	cd /d D:\7-Zip\code\build && $(MAKE) $(MAKESILENT) -f ciphers\CMakeFiles\xor_cipher.dir\build.make ciphers/CMakeFiles/xor_cipher.dir/xor_cipher.cpp.s
.PHONY : xor_cipher.cpp.s

