# target to build an object file
knapsack.cpp.obj:
	cd /d D:\7-Zip\code\build && $(MAKE) $(MAKESILENT) -f greedy_algorithms\CMakeFiles\knapsack.dir\build.make greedy_algorithms/CMakeFiles/knapsack.dir/knapsack.cpp.obj
.PHONY : knapsack.cpp.obj

